# ==============================================================================
# chDB Brain (Shared Agent Memory MCP + HTTP Server) — SSOT Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
# ==============================================================================

CHDB_BRAIN_LISTEN_IP=0.0.0.0
CHDB_BRAIN_CONNECT_IP=127.0.0.1
CHDB_BRAIN_PORT=8765
CHDB_BRAIN_DB_NAME=brain
CHDB_BRAIN_DATA_DIR=/data
CHDB_BRAIN_MEM_LIMIT=512m
# Low-memory tuning (idle auto-close + per-query caps)
CHDB_BRAIN_IDLE_CLOSE_SEC=60
CHDB_BRAIN_MAX_THREADS=2
CHDB_BRAIN_MAX_QUERY_MEM_BYTES=268435456
TZ=Asia/Singapore

# Client Reference URLs
CHDB_BRAIN_BASE_URL=http://${CHDB_BRAIN_CONNECT_IP}:${CHDB_BRAIN_PORT}
CHDB_BRAIN_MCP_URL=http://${CHDB_BRAIN_CONNECT_IP}:${CHDB_BRAIN_PORT}/mcp

# Optional Local S3 (RustFS) Backup / Restore Configuration
# Matches local-infra/rustfs defaults (no cloud S3 fees)
CHDB_BRAIN_S3_ENDPOINT=http://127.0.0.1:9100
CHDB_BRAIN_S3_BUCKET=agent-brain
CHDB_BRAIN_S3_PREFIX=brains/vin
CHDB_BRAIN_S3_ACCESS_KEY=rustfsadmin
CHDB_BRAIN_S3_SECRET_KEY=rustfsadmin
