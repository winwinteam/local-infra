# ==============================================================================
# RustFS (Local Self-Hosted S3-Compatible Object Storage) — SSOT Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
# ==============================================================================

RUSTFS_IMAGE_TAG=latest
RUSTFS_LISTEN_IP=0.0.0.0
RUSTFS_CONNECT_IP=127.0.0.1
# Avoid :9000 (HyperDX ClickHouse) and :9090 (Langfuse MinIO)
RUSTFS_S3_PORT=9100
RUSTFS_CONSOLE_PORT=9101
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_MEM_LIMIT=512m
# Local hard disk directory where RustFS stores S3 buckets/objects
RUSTFS_DATA_DIR=./data
TZ=Asia/Singapore

# Local development credentials (change in .env before starting)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_DEFAULT_BUCKET=agent-brain

# Client Reference URLs
RUSTFS_S3_ENDPOINT=http://${RUSTFS_CONNECT_IP}:${RUSTFS_S3_PORT}
RUSTFS_CONSOLE_URL=http://${RUSTFS_CONNECT_IP}:${RUSTFS_CONSOLE_PORT}
