# ==============================================================================
# Aspire Dashboard (Standalone Local OTel UI) — SSOT Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env
# ==============================================================================

ASPIRE_IMAGE_TAG=13.6
ASPIRE_LISTEN_IP=127.0.0.1
ASPIRE_CONNECT_IP=127.0.0.1
ASPIRE_UI_PORT=18888
ASPIRE_OTLP_GRPC_PORT=4317
ASPIRE_OTLP_HTTP_PORT=4318
ASPIRE_MEM_LIMIT=256m
TZ=Asia/Singapore

# In-memory telemetry retention caps (sized for ASPIRE_MEM_LIMIT=256m)
ASPIRE_MAX_TRACE_COUNT=2000
ASPIRE_MAX_LOG_COUNT=5000
ASPIRE_MAX_METRICS_COUNT=20000
ASPIRE_MAX_ATTRIBUTE_LENGTH=1024

# Client Reference URLs
ASPIRE_UI_URL=http://${ASPIRE_CONNECT_IP}:${ASPIRE_UI_PORT}
ASPIRE_OTLP_ENDPOINT=http://${ASPIRE_CONNECT_IP}:${ASPIRE_OTLP_HTTP_PORT}
